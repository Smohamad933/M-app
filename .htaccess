# ==============================================================================
# TaskRooz - Apache Server Configuration
# Compatible with cPanel, DirectAdmin, Plesk, LiteSpeed, Apache 2.4+
# ==============================================================================

# Enable HTTP Authorization header for FastCGI / PHP-FPM / CGI
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteRule .* - [E=HTTP_X_AUTH_TOKEN:%{HTTP:X-Auth-Token}]
</IfModule>

<IfModule mod_authz_core.c>
    CGIPassAuth On
</IfModule>

# Protect sensitive data directories & files from direct HTTP access
<IfModule mod_rewrite.c>
    RewriteRule ^data/ - [F,L,NC]
    RewriteRule ^\.git - [F,L,NC]
</IfModule>

<FilesMatch "\.(json|sql|log|md|lock|env|bak)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Allow access to index.html and SPA frontend routes
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/(api|data)/
    RewriteRule ^ index.html [L]
</IfModule>
