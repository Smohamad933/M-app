{
  "name": "temp-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "cp index.source.html index.html && tsc -b && vite build && cp dist/index.html index.html && cp -r dist/assets . && for f in dist/*; do case $(basename $f) in index.html|assets) ;; *) cp -r $f . ;; esac; done",
    "lint": "oxlint",
    "test": "node test-suite.cjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "@fontsource/vazirmatn": "^5.3.0",
    "canvas-confetti": "^1.9.4",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "html2canvas-pro": "^2.5.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sahel-font": "^3.4.0",
    "samim-font": "^4.0.5",
    "shabnam-font": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/html2canvas": "^0.5.35",
    "@types/jszip": "^3.4.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
